Options -Indexes

<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>

<FilesMatch "\.(sqlite|sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
